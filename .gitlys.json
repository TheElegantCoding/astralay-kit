{
  "lintStaged": {
    "*.astro": "bunx astro check",
    "*.{ts,js,jsx,tsx,json,html,yml,yaml,astro}": "bunx eslint --fix",
    "*.{css,scss}": "bunx stylelint --fix"
  },
  "release": {
    "releaseToGithub": true
  },
  "changelog": {
    "changelogPath": "CHANGELOG.md",
    "generateChangelog": true
  },
  "packageManager": "bun"
}