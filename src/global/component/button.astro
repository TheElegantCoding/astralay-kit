---
import type { HTMLAttributes } from 'astro/types';

type ButtonProps = HTMLAttributes<'button'> & {
  readonly text?: string;
  readonly class?: string;
  readonly variant?: 'outline' | 'rounded' | 'gradient';
};

type Props = ButtonProps;

const {
  text,
  class: classButton,
  variant,
  ...rest
} = Astro.props;

const hasSlot = Astro.slots.has('default');
---
<div
  class:list={classButton}
  class:list={`button ${variant ? `button--${variant}` : ''}`}
  {...rest}>
  {hasSlot ? <slot /> : <span>{text}</span>}
</div>