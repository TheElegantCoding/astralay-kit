---
import type { HTMLAttributes } from 'astro/types';

export type OverlayProps = HTMLAttributes<'span'> & {
  readonly class?: string;
  readonly visible?: boolean;
};

type Props = OverlayProps;

const { class: classOverlay, visible, ...rest } = Astro.props;
---
<span
  class='overlay'
  class:list={[classOverlay, visible && 'overlay--active']}
  {...rest}
/>