---
import type { HTMLAttributes } from 'astro/types';

type ScrollProps = HTMLAttributes<'div'> & {
  class?: string;
  orientation?: 'vertical' | 'horizontal';
};

type Props = ScrollProps;

const { class: classScroll, orientation = 'vertical' } = Astro.props;
---
<div
  class='scroll'
  data-scroll={orientation}
  class:list={[orientation === 'horizontal' && classScroll]}
>
  <div
    data-scroll-start
    class='scroll__fade scroll__fade--active'
    class:list={[orientation === 'horizontal' && 'scroll__fade-horizontal']}
  />
  <div class='scroll__container' class:list={[orientation === 'horizontal' && 'scroll__container--horizontal', classScroll]}>
    <slot />
  </div>
  <div
    data-scroll-end
    class='scroll__fade scroll__fade-bottom scroll__fade--active'
    class:list={[orientation === 'horizontal' && 'scroll__fade-horizontal scroll__fade-horizontal-right']}
  />
</div>

<script>
  const scroll = document.querySelectorAll('[data-scroll]');

  scroll.forEach((scroll) => {
    const container = scroll.querySelector('.scroll__container');
    const orientation = scroll.getAttribute('data-scroll');
    const scrollStart = scroll.querySelector('[data-scroll-start]');
    const scrollEnd = scroll.querySelector('[data-scroll-end]');

    const showFade = (container: HTMLElement) => {

      if(orientation === 'vertical') {
        if (container?.scrollTop > 0) {
          scrollStart?.classList.add('scroll__fade--active');
        } else {
          scrollStart?.classList.remove('scroll__fade--active');
        }

        if (container?.scrollTop + container?.clientHeight < container?.scrollHeight) {
          scrollEnd?.classList.add('scroll__fade--active');
        } else {
          scrollEnd?.classList.remove('scroll__fade--active');
        }
      }

      if(orientation === 'horizontal') {
        if (container?.scrollLeft > 0) {
          scrollStart?.classList.add('scroll__fade--active');
        } else {
          scrollStart?.classList.remove('scroll__fade--active');
        }

        if (container?.scrollLeft + container?.clientWidth < container?.scrollWidth) {
          scrollEnd?.classList.add('scroll__fade--active');
        } else {
          scrollEnd?.classList.remove('scroll__fade--active');
        }
      }
    };

    container?.addEventListener('scroll', () => {
      showFade(container as HTMLElement);
    });

    showFade(container as HTMLElement);
  });

</script>