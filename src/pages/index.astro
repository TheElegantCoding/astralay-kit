---
import Accordion from './../global/component/accordion.astro';
import Alert from './../global/component/alert.astro';
import Button from './../global/component/button.astro';
import CustomImage from './../global/component/custom_image.astro';
import Icon from './../global/component/icon.astro';
import Illustration from './../global/component/illustration.astro';
import Modal from './../global/component/modal.astro';
import Navbar from './../global/component/navbar.astro';
import Overlay from './../global/component/overlay.astro';
import Scroll from './../global/component/scroll.astro';
import Skeleton from './../global/component/skeleton.astro';

import './../global/style/main.scss';
---
<main class='base-layout'>
  <Navbar />
  <h1 class='text-gradient'>Hola mundo</h1>
  <Icon name='square' />
  <Illustration name='logo_astralys' />
  <Skeleton class='custom-skeleton' />
  <button id='alert' class='button'>
    open alert
  </button>
  <Alert
    id='test'
    title='Alert'
    type='success'
    message='message'
    position='bottom-right'
  />
  <Accordion title='Accordion'>
    <p>description</p>
  </Accordion>
  <Overlay />
  <Button id='modal'>
    Open modal
  </Button>
  <CustomImage
    alt='alt'
    layout='constrained'
    data-animate='fade-in-left'
    src='/src/global/asset/image/image_placeholder.png'
  />
  <Modal id='test' title='Modal'>
    <h1>Hola mundo</h1>
  </Modal>
  <Scroll class='scroll-test' orientation='vertical'>
    <div class='box' />
    <div class='box' />
    <div class='box' />
    <div class='box' />
    <div class='box' />
    <div class='box' />
    <div class='box' />
  </Scroll>
  <div class='section-test'>
    <p class='text-reveal'>lorem ipsum dolor sit amet </p>
  </div>
  <div class='section-test section-test__transparent' />
  <div class='section-test'>
    <div class='box scroll-zoom-in-left' />
    <div class='box scroll-zoom-in-right' />
    <div class='box scroll-zoom-in-up' />
    <div class='box scroll-zoom-in-down' />
  </div>

</main>

<script>
  import { animate } from './../global/util/animation';
  import { toggleModal } from './../global/util/modal';
  import { showAlert } from './../global/util/alert';

  const button = document.querySelector('#modal');
  const buttonAlert = document.querySelector('#alert');
  const buttonModal = document.querySelector('#test');

  button?.addEventListener('click', () => toggleModal('test'))
  buttonAlert?.addEventListener('click', () => showAlert('test'))
  buttonModal?.addEventListener('click', () => toggleModal('test'))

  animate();
</script>